      "id": "r1",
      "name": "Telegram Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "bs-telegram",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_WEBHOOK_SECRET",
          "name": "BS Telegram Webhook Secret"
        }
      },
      "notes": "Webhook normal en vez de Telegram Trigger: la URL se registra a mano con setWebhook (no depende de WEBHOOK_URL del servidor). Header Auth valida el secret_token que Telegram envía en cada update; sin él, 403."
    },
    {
      "id": "r2",
      "name": "Normalizar y whitelist",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Whitelist de chat_id: el bot ignora a cualquiera que no esté aquí.\nconst ALLOWED = [\"TU_CHAT_ID\"]; // TODO: reemplaza por tu chat_id numérico real (pídeselo a @userinfobot)\n\nconst u = $json.body ?? {};\nconst cq = u.callback_query;\nconst chat = u.message?.chat ?? cq?.message?.chat;\nconst chatId = chat ? String(chat.id) : '';\n\n// Solo chats privados de la whitelist; lo demás termina aquí sin responder.\nif (!chat || chat.type !== 'private' || !ALLOWED.includes(chatId)) return [];\n\nreturn [{ json: {\n  update_id: u.update_id,\n  type: cq ? 'callback_query' : (u.message ? 'message' : 'other'),\n  chat_id: chatId,\n  text: u.message?.text ?? null,\n  callback_data: cq?.data ?? null,\n  callback_query_id: cq?.id ?? null,\n  message_id: (u.message ?? cq?.message)?.message_id ?? null,\n}}];"
      }
    },
    {
      "id": "r3",
      "name": "Clasificar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const t = ($json.text || '').trim();\nconst cb = $json.callback_data || '';\nlet kind;\nif ($json.type === 'callback_query') {\n  // q:<uuid>:<índice> = respuesta a un quiz\n  // n:quiz = \"Otra pregunta\"; h:n:<test_id> = \"Siguiente pregunta\" del test\n  // n:hoy = \"Siguiente lección\"; h:t:<orden> = \"Ponerme a prueba\"; h:s:<orden> = \"Ya lo sé\"\n  if (cb.startsWith('q:')) kind = 'respuesta';\n  else if (cb === 'n:quiz' || cb.startsWith('h:n:')) kind = 'quiz';\n  else if (cb === 'n:hoy' || cb.startsWith('h:t:') || cb.startsWith('h:s:')) kind = 'hoy';\n  else kind = 'callback';\n}\nelse if (/^\\/start\\b/i.test(t)) kind = 'start';\nelse if (/^\\/quiz\\b/i.test(t)) kind = 'quiz';\nelse if (/^\\/(hoy|saltar)\\b/i.test(t)) kind = 'hoy';\nelse if (/^\\/progreso\\b/i.test(t)) kind = 'progreso';\nelse if (/^\\/hora\\b/i.test(t)) kind = 'hora';\nelse if (t && !t.startsWith('/')) kind = 'pregunta';\nelse if (/^\\/pregunta\\b/i.test(t)) kind = 'pregunta';\nelse kind = 'otro_comando';\nreturn [{ json: { ...$json, kind } }];"
      }
    },
