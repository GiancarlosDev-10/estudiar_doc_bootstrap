    {
      "id": "x2",
      "name": "Preparar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body ?? {};\nconst base = { tipo: b.tipo, chat_id: 0, dry_run: true };\nswitch (b.tipo) {\n  case 'hoy': return { json: { ...base, text: '/hoy' } };\n  case 'test': return { json: { ...base, callback_data: 'h:t:' + b.orden, message_id: b.message_id ?? 1 } };\n  case 'saltar': return { json: { ...base, text: '/saltar' } };\n  case 'progreso': return { json: base };\n  case 'turnos': return { json: { ...base, hour: b.hour } };\n  case 'hora': return { json: { ...base, text: ('/hora ' + (b.args ?? '')).trim() } };\n  default: return { json: { ...base, tipo: 'error', error: 'tipo desconocido: ' + b.tipo } };\n}"
      }
    },
