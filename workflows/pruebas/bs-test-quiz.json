    },
    {
      "id": "t4",
      "name": "Juntar resultados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const temas = $('Preparar temas').all().map((i) => i.json.tema);\nreturn [{ json: { results: $input.all().map((i, k) => ({ tema: temas[k], ...i.json })) } }];"
      }
    },
    {
      "id": "t5",
