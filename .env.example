# Variables que usa n8n-mcp (.mcp.json). Defínelas como variables de entorno
# de Windows; Claude Code NO lee este archivo ni un .env automáticamente.
N8N_API_URL=
N8N_API_KEY=

# Fase 3: secreto del header X-BS-Test-Secret, para llamar a [BS] Test RAG
# (eval/*.json) sin pasar por Telegram. Mismo valor que la credencial
# "BS Test RAG Secret" de n8n. Es distinto del secreto del webhook de
# Telegram: si se cambia uno, no hay que tocar el otro ni repetir setWebhook.
BS_TEST_RAG_SECRET=
